NODE_ENV=development

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

BASE_URL=https://web.telegram.org/a/

# Brand name shown in <title>, application-name, mobile-web-app-title, and
# Open Graph title. Defaults to "TChat" so the built page does not impersonate
# web.telegram.org. ALWAYS set a domain-specific title per environment.
# Example: APP_TITLE=TChat · tgb.example.com
APP_TITLE=

# Brand description shown in <meta name="description">, og:description, and
# twitter:description. Default is non-branded and self-identifying (TChat),
# but you should still set a domain-specific value per environment.
# Example: APP_DESCRIPTION=TChat — messaging web client for tgb.example.com. Open source: github.com/example/telegram-tt-beauty
APP_DESCRIPTION=

# og:image / twitter:image filename (without extension), relative to dist/.
# Default is the TChat mark (public/tchat-icon-192.png). Override to ship a
# per-environment share image.
# Example: OG_IMAGE=tchat-icon-192
OG_IMAGE=
