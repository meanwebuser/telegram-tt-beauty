# Versioned public images. Do not put secrets in this file.
TGB_VERSION=12.0.32
TGB_WEB_IMAGE=ghcr.io/meanwebuser/telegram-tt-beauty-web
TGB_PROXY_IMAGE=ghcr.io/meanwebuser/telegram-tt-beauty-proxy

# Bind the web container locally by default; put nginx/Caddy in front for HTTPS.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Keep the proxy runtime environment outside the Compose file.
TGB_PROXY_ENV_FILE=./proxy.env
