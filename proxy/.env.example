# Required: an HTTP(S) proxy URL used for Telegram Web egress.
TELEGRAM_UPSTREAM_PROXY=http://proxy.example:3128

# Optional comma-separated browser origins for direct cross-origin access.
# Leave empty when the static site and /proxy/ share one origin (the Compose default).
PUBLIC_ORIGINS=

# Optional: enables POST /proxy/whisper-v1/ for an OpenAI-compatible
# transcription endpoint. Keep the real key only in proxy/.env.
WHISPER_UPSTREAM=https://whisper.example/v1
WHISPER_API_KEY=
